model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","Economy","Population","Energy","CountryData Unpivot","Country_Data","Country_Continent","Measure"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","CalcGroup"]

ref table Economy
ref table Population
ref table Energy
ref table 'CountryData Unpivot'
ref table Measure

ref cultureInfo en-US

