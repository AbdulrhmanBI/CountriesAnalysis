	measure Video =
			
			"<style>
			  html,body{margin:0;height:100%;overflow:hidden;background:transparent}
			  video{width:100%;height:100%;object-fit:cover;display:block}
			  .btn{
			    position:absolute; bottom:12%; width:18%; height:7%;
			    display:flex; align-items:center; justify-content:center;
			    font-family:Segoe UI,Arial,sans-serif; font-size:1.4vw; letter-spacing:.12em;
			    text-transform:uppercase; color:#e6f1ff;
			    background:rgba(10,40,90,.55); border:1px solid #4aa8ff; border-radius:4px;
			    opacity:0; animation:show 1s ease 10.5s forwards;
			  }
			  @keyframes show{to{opacity:1}}
			</style>
			<video autoplay muted playsinline src='https://raw.githubusercontent.com/AbdulrhmanBI/CountriesAnalysis/main/Video/CountryData.mp4'></video>
			</video>
			<div class='btn' style='left:11%'>Overview</div>
			<div class='btn' style='left:31%'>Population</div>
			<div class='btn' style='left:51%'>Economy</div>
			<div class='btn' style='left:71%'>Energy</div>"
		lineageTag: 05307b17-dbe1-49f2-bd09-994e0fcd534f

