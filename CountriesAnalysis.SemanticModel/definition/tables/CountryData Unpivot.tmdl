	column 'Income Group' =
			
			SWITCH(
			    TRUE(),
			    ISBLANK(RELATED(Economy[GDP per Capita])),
			    "Unclassified",
			    RELATED(Economy[GDP per Capita]) < 1136,
			    "Low income",
			    RELATED(Economy[GDP per Capita]) < 4466,
			    "Lower-middle income",
			    RELATED(Economy[GDP per Capita]) < 13846,
			    "Upper-middle income",
			    "High income"
			)
		lineageTag: a8a52c35-2489-4ed0-9db8-802230a8002d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'CountryData Unpivot' = m
		mode: import
		source =
				let
				    Source = Country_Data,
				    #"Unpivoted Other Columns" = Table.UnpivotOtherColumns(Source, {"Country"}, "Attribute", "Value"),
				    #"Renamed Columns" = Table.RenameColumns(#"Unpivoted Other Columns",{{"Attribute", "Indicator"}}),
				    #"Filtered Rows3" = Table.SelectRows(#"Renamed Columns", each [Value] <> null),
				    #"Merged Queries" = Table.NestedJoin(#"Filtered Rows3", {"Country"}, Country_Continent, {"Country"}, "Country_Continent", JoinKind.LeftOuter),
				    #"Expanded Country_Continent" = Table.ExpandTableColumn(#"Merged Queries", "Country_Continent", {"Continent"}, {"Continent"}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Expanded Country_Continent",{"Country", "Continent", "Indicator", "Value"})
				in
				    #"Reordered Columns"

